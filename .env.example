# Example environment variables for AppForge
# Copy this file to .env.local and populate the secrets.
# Never commit real keys to git.

# 21st.dev Component Registry API Key
API_KEY_21ST=your-21st-dev-key

# InsForge / Supabase
NEXT_PUBLIC_INSFORGE_URL=https://your-project.supabase.co
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Copilot Keys
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
